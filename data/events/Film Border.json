{
	"params": [
		{
			"name": "Is Tweened?",
			"type": "Bool",
			"defaultValue": true
		},
		{
			"name": "Border Height",
			"type": "Float(-10.0, 10.0, 0.001, 3)",
			"defaultValue": 1.0
		},
		{
			"name": "Tween Time (Steps, IF NOT CLASSIC)",
			"type": "Float(0.1, 9999, 0.1, 1)",
			"defaultValue": 4
		},
		{
			"name": "Tween Ease (ex: circ, quad, cube)",
			"type": "DropDown(['CLASSIC', 'linear', 'back', 'bounce', 'circ', 'cube', 'elastic', 'expo', 'quad', 'quart', 'quint', 'sine', 'smoothStep', 'smootherStep'])",
			"defaultValue": "linear"
		},
		{
			"name": "Tween Type (excluded if linear, ex: InOut)",
			"type": "DropDown(['In', 'Out', 'InOut'])",
			"defaultValue": "In"
		},
		{
			"name": "Should Pulsate Relatively? (Must have tweening on)",
			"type": "Bool",
			"defaultValue": false
		}
	]
}
